{
    "name": "nexora",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:e2e": "tsc && vite build --mode e2e",
        "build:e2e:app": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
        "audit:frontend": "bun audit --ignore GHSA-jmr9-qjv8-65gv && bun run verify:extract-zip",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "tauri": "tauri",
        "test:e2e": "bun run build:e2e:app && wdio run e2e/wdio.conf.ts",
        "test:e2e:run": "wdio run e2e/wdio.conf.ts",
        "verify:extract-zip": "bun scripts/security/verify-extract-zip-patch.mjs",
        "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore .prettierrc \"**/*.{json,md,mjs,js,ts,tsx,jsx}\"",
        "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore .prettierrc \"**/*.{json,md,mjs,js,ts,tsx,jsx}\""
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-icons": "^5.7.0",
        "sonner": "^2.0.8"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "@types/bun": "^1.4.0",
        "@types/node": "^26.2.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "@wdio/cli": "^9.31.2",
        "@wdio/globals": "^9.31.1",
        "@wdio/local-runner": "^9.31.4",
        "@wdio/mocha-framework": "^9.31.2",
        "@wdio/spec-reporter": "^9.31.2",
        "@wdio/tauri-plugin": "1.3.0",
        "@wdio/tauri-service": "^1.3.0",
        "prettier": "^3.8.3",
        "typescript": "~5.8.3",
        "vite": "^8.2.2"
    },
    "overrides": {
        "deepmerge-ts": "8.0.1",
        "nanoid": "3.3.18",
        "serialize-javascript": "7.1.0"
    },
    "patchedDependencies": {
        "extract-zip@2.0.1": "patches/extract-zip@2.0.1.patch"
    }
}
