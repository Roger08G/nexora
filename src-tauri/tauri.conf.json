{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Nexora",
    "version": "0.1.0",
    "identifier": "com.roger-gomez-martinez.nexora",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Nexora",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 720
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self' customprotocol: asset:",
                "connect-src": "ipc: http://ipc.localhost",
                "font-src": "'self' data:",
                "img-src": "'self' asset: http://asset.localhost blob: data:",
                "style-src": "'self' 'unsafe-inline'"
            },
            "devCsp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
